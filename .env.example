# --- PayPal sandbox REST app ---
# From developer.paypal.com -> Apps & Credentials -> SANDBOX tab (default app is fine).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Hard guard: asa refuses any value other than SANDBOX (see asa/config.py).
PAYPAL_ENVIRONMENT=SANDBOX

# Optional: pre-minted access token for the local MCP stdio server (valid 3-8 h;
# mint with POST /v1/oauth2/token). The REST client mints its own.
PAYPAL_ACCESS_TOKEN=

# --- Spike-2 card path (only needed for order capture without buyer UI) ---
# Must be a number from the official sandbox card-testing page:
# https://developer.paypal.com/sandbox-testing/card-testing#test-card-numbers
# Future expiry date; CVV length 3 (4 for AmEx).
ASA_CARD_PAN=
ASA_CARD_EXPIRY=
ASA_CARD_CVV=

# --- Spike-3 invoice round-trip ---
# Personal (buyer) sandbox account email (sb-xxxx@personal.example.com),
# used as invoice recipient so send/record lifecycle can be exercised.
ASA_SANDBOX_PERSONAL_EMAIL=

# --- NVIDIA hosted model (optional; only scripts/agent_probe.py) ---
# Get a key at build.nvidia.com. Leave empty to skip the NVIDIA leg of the
# agent probe (the GLM leg runs without any key).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- MCP endpoints ---
# Remote streamable HTTP endpoint; auth attempt is a Bearer header, else fall back to stdio.
ASA_MCP_REMOTE_URL=https://mcp.sandbox.paypal.com/http
# Windows fallback if bare "npx" will not spawn: ASA_MCP_STDIO_COMMAND=npx.cmd

# --- Receipts ---
ASA_RUNS_DIR=runs
