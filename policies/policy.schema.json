{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "asa://policy/v0",
  "title": "Agent Surface Audit policy DSL v0",
  "description": "What the LLM compiles natural-language policy into. The deterministic checker (not the LLM) validates sequences against this. Money values are strings to match PayPal wire format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "currency", "refund"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "currency": { "const": "USD" },
    "refund": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_refund_max", "total_refund_max"],
      "properties": {
        "per_refund_max": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{2})?$" },
        "total_refund_max": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{2})?$" },
        "total_scope": { "enum": ["per_invoice"] },
        "forbid_after": {
          "type": "array",
          "items": { "enum": ["dispute_open", "invoice_cancelled"] },
          "uniqueItems": true
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "per_capture_max": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{2})?$" },
        "total_captures_max_per_invoice": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
